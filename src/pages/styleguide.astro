---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/ui/Logo.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Heading from '../components/ui/Heading.astro';
import Tag from '../components/ui/Tag.astro';
import Button from '../components/ui/Button.astro';
import Field from '../components/ui/Field.astro';
import Card from '../components/ui/Card.astro';
import Accordion from '../components/ui/Accordion.astro';
import AccordionItem from '../components/ui/AccordionItem.astro';

const colours = [
  { name: 'Background', token: '--color-bg', hex: '#142B22' },
  { name: 'Background deep', token: '--color-bg-deep', hex: '#10231C' },
  { name: 'Surface', token: '--color-surface', hex: '#1D3A2F' },
  { name: 'Surface raised', token: '--color-surface-raised', hex: '#24463A' },
  { name: 'Text', token: '--color-text', hex: '#E8F5ED' },
  { name: 'Text muted', token: '--color-text-muted', hex: '#B3C7BB' },
  { name: 'Text subtle', token: '--color-text-subtle', hex: '#83A192' },
  { name: 'Accent (mint)', token: '--color-accent', hex: '#7EE8A8' },
  { name: 'Accent ink', token: '--color-accent-ink', hex: '#0F2A1F' },
  { name: 'Gold', token: '--color-gold', hex: '#E3C98A' },
  { name: 'Danger', token: '--color-danger', hex: '#FF9B8A' },
];

const scale = [
  { name: 'Display / H1', token: '--text-display', spec: 'Sora 300 + 600 · 40→56px · lh 1.04', cls: 'heading-display' },
  { name: 'H2', token: '--text-h2', spec: 'Sora 300 + 600 · 32→48px · lh 1.1', cls: 'heading-h2' },
  { name: 'H3', token: '--text-h3', spec: 'Sora 600 · 20→24px · lh 1.25', cls: 'heading-h3' },
];
---

<Layout title="Style guide — Incumbency.AI" description="Incumbency.AI design tokens and components." noindex>
  <div class="sg">
    <header class="sg-hero">
      <div class="wrap sg-hero__inner">
        <Logo />
        <div class="sg-hero__copy">
          <Eyebrow variant="badge">Style guide · v1</Eyebrow>
          <Heading level={1}>Incumbency.AI <strong>design system.</strong></Heading>
          <p class="lead">
            Tokens and components for the "Claim your bag" landing page. Titles in Sora, copy in IBM Plex Sans,
            buttons and data in IBM Plex Mono.
          </p>
        </div>
      </div>
    </header>

    <main class="wrap sg-main">
      <!-- Colour -->
      <section class="sg-section" aria-labelledby="sg-colour">
        <div class="sg-section__head">
          <Eyebrow>01 · Colour</Eyebrow>
          <Heading level={2} size="h3" id="sg-colour">Palette</Heading>
        </div>
        <ul class="swatches">
          {
            colours.map((c) => (
              <li class="swatch">
                <span class="swatch__chip" style={`background: var(${c.token})`} />
                <span class="swatch__name">{c.name}</span>
                <code class="swatch__meta">{c.hex}</code>
                <code class="swatch__meta">{c.token}</code>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Typography -->
      <section class="sg-section" aria-labelledby="sg-type">
        <div class="sg-section__head">
          <Eyebrow>02 · Typography</Eyebrow>
          <Heading level={2} size="h3" id="sg-type">Families</Heading>
        </div>

        <div class="families">
          <Card variant="solid">
            <p class="family__label">Title — Sora</p>
            <p class="family__sample family__sample--title">Aa <span>Light 300</span> <strong>SemiBold 600</strong></p>
            <p class="family__chars title-font">ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789</p>
          </Card>
          <Card variant="solid">
            <p class="family__label">Body — IBM Plex Sans</p>
            <p class="family__sample family__sample--body">Aa <span>Regular 400</span> <em>Italic</em> <strong>SemiBold 600</strong></p>
            <p class="family__chars">ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789</p>
          </Card>
          <Card variant="solid">
            <p class="family__label">Buttons &amp; data — IBM Plex Mono</p>
            <p class="family__sample family__sample--mono">Aa <span>Regular 400</span> <strong>SemiBold 600</strong></p>
            <p class="family__chars mono-font">ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789 → ↑</p>
          </Card>
        </div>

        <div class="sg-section__head sg-section__head--sub">
          <Heading level={3} size="h3">Scale</Heading>
        </div>
        <div class="scale">
          <div class="scale__row">
            <div class="scale__meta"><strong>{scale[0].name}</strong><code>{scale[0].token}</code><span>{scale[0].spec}</span></div>
            <Heading level={2} size="display">Let's make <strong>democratic data more secure.</strong></Heading>
          </div>
          <div class="scale__row">
            <div class="scale__meta"><strong>{scale[1].name}</strong><code>{scale[1].token}</code><span>{scale[1].spec}</span></div>
            <Heading level={2}>Your own private AI,<br /><strong>safe from day one.</strong></Heading>
          </div>
          <div class="scale__row">
            <div class="scale__meta"><strong>{scale[2].name}</strong><code>{scale[2].token}</code><span>{scale[2].spec}</span></div>
            <Heading level={3}>Built to support teams, not replace them</Heading>
          </div>
          <div class="scale__row">
            <div class="scale__meta"><strong>Lead</strong><code>--text-lead</code><span>Plex Sans 400 · 17→19px · lh 1.6</span></div>
            <p class="lead">
              We are giving away anti-theft laptop bags to Parliamentary staffers to protect physical data security.
              Claim yours today.
            </p>
          </div>
          <div class="scale__row">
            <div class="scale__meta"><strong>Body</strong><code>--text-body</code><span>Plex Sans 400 · 17px · lh 1.6</span></div>
            <p class="body-copy">
              Incumbency.ai is the AI-powered, human guided platform built for politicians teams. Every office gets its
              own private AI, backed by third-party testing, UK data hosting, and zero retention on everything you put in.
            </p>
          </div>
          <div class="scale__row">
            <div class="scale__meta"><strong>Small</strong><code>--text-small</code><span>Plex Sans 400 · 15px · lh 1.7</span></div>
            <p class="small-copy">
              All of your data is held in the UK. Our AI never retains data or uses it to train models — each office has
              its own private AI, drawing only on its own knowledge base.
            </p>
          </div>
          <div class="scale__row">
            <div class="scale__meta"><strong>Label</strong><code>--text-label</code><span>Plex Mono 500 · 12px · caps · +0.18em</span></div>
            <Eyebrow>AI-powered · Human-guided</Eyebrow>
          </div>
        </div>
      </section>

      <!-- Brand -->
      <section class="sg-section" aria-labelledby="sg-brand">
        <div class="sg-section__head">
          <Eyebrow>03 · Brand</Eyebrow>
          <Heading level={2} size="h3" id="sg-brand">Logo, eyebrows &amp; tags</Heading>
        </div>
        <div class="row">
          <Logo />
          <Logo size="lg" />
        </div>
        <div class="row">
          <Eyebrow variant="badge">Claim your bag</Eyebrow>
          <Eyebrow>What is Incumbency.AI?</Eyebrow>
        </div>
        <div class="row">
          <Tag>CREST Tested</Tag>
          <Tag>Cyber Essentials Plus</Tag>
          <Tag variant="gold">UK Data Residency</Tag>
        </div>
      </section>

      <!-- Buttons -->
      <section class="sg-section" aria-labelledby="sg-buttons">
        <div class="sg-section__head">
          <Eyebrow>04 · Actions</Eyebrow>
          <Heading level={2} size="h3" id="sg-buttons">Buttons</Heading>
        </div>
        <div class="states">
          <div class="state"><Button icon="arrow-right">Get my bag</Button><span>Primary</span></div>
          <div class="state"><Button icon="arrow-right" class="is-hover">Get my bag</Button><span>Primary · hover</span></div>
          <div class="state"><Button icon="arrow-right" disabled>Sending…</Button><span>Primary · disabled</span></div>
          <div class="state"><Button variant="outline" icon="arrow-up" href="#top">Back to the form</Button><span>Outline</span></div>
          <div class="state"><Button variant="outline" icon="arrow-up" href="#top" class="is-hover">Back to the form</Button><span>Outline · hover</span></div>
        </div>
        <div class="block-demo">
          <Button icon="arrow-right" block>Get my bag</Button>
          <span class="state-caption">Primary · full width (form submit)</span>
        </div>
      </section>

      <!-- Form -->
      <section class="sg-section" aria-labelledby="sg-form">
        <div class="sg-section__head">
          <Eyebrow>05 · Forms</Eyebrow>
          <Heading level={2} size="h3" id="sg-form">Fields &amp; card</Heading>
        </div>
        <div class="form-demo">
          <div class="field-states">
            <Field label="Full name" name="sg-name" placeholder="Jane Okafor" />
            <div class="force-focus"><Field label="Email" name="sg-email" type="email" value="jane.okafor@parliament.uk" /></div>
            <Field label="Mobile" name="sg-mobile" type="tel" value="07700" error="Please enter a UK mobile number starting 07 or +44." />
            <p class="state-caption">Empty · focus/filled · error</p>
          </div>

          <div class="card-demo">
            <Card>
              <form class="claim-grid" onsubmit="return false">
                <div class="span-2"><Field label="Full name" name="demo-name" placeholder="Jane Okafor" autocomplete="name" /></div>
                <Field label="Mobile" name="demo-mobile" type="tel" placeholder="07700 000000" autocomplete="tel" />
                <Field label="MP's office" name="demo-office" placeholder="MP's Office" autocomplete="organization" />
                <div class="span-2"><Field label="Email" name="demo-email" type="email" placeholder="you@parliament.uk" autocomplete="email" /></div>
                <div class="span-2 submit"><Button type="submit" icon="arrow-right" block>Get my bag</Button></div>
              </form>
            </Card>
          </div>
        </div>
      </section>

      <!-- Accordion -->
      <section class="sg-section" aria-labelledby="sg-accordion">
        <div class="sg-section__head">
          <Eyebrow>06 · Disclosure</Eyebrow>
          <Heading level={2} size="h3" id="sg-accordion">Accordion</Heading>
        </div>
        <div class="acc-demo">
          <Accordion>
            <AccordionItem title="UK-held. Never retained." open>
              <p>
                All of your data is held in the UK. Our AI never retains data or uses it to train models — each office has
                its own private AI, drawing only on its own knowledge base.
              </p>
            </AccordionItem>
            <AccordionItem title="Built to support teams, not replace them">
              <p>
                Cases are automatically verified, tagged, triaged, and routed to the right staff member with AI-assisted
                draft responses ready for review and sending.
              </p>
            </AccordionItem>
          </Accordion>
        </div>
      </section>

      <!-- Tokens -->
      <section class="sg-section" aria-labelledby="sg-tokens">
        <div class="sg-section__head">
          <Eyebrow>07 · Foundations</Eyebrow>
          <Heading level={2} size="h3" id="sg-tokens">Radius, spacing &amp; background</Heading>
        </div>
        <div class="row radii">
          <div class="radius" style="border-radius: var(--radius-tag)"><code>tag 4</code></div>
          <div class="radius" style="border-radius: var(--radius-input)"><code>input 10</code></div>
          <div class="radius" style="border-radius: var(--radius-panel)"><code>panel 16</code></div>
          <div class="radius" style="border-radius: var(--radius-card)"><code>card 24</code></div>
          <div class="radius" style="border-radius: var(--radius-pill)"><code>pill</code></div>
        </div>
        <div class="row spacing">
          {
            [1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => (
              <div class="space">
                <span class="space__bar" style={`width: var(--space-${n})`} />
                <code>--space-{n}</code>
              </div>
            ))
          }
        </div>
        <div class="bg-preview" role="img" aria-label="Bokeh background image fading into the page background"></div>
        <p class="state-caption">Hero background — <code>/images/bokeh-bg.webp</code>, top-anchored, fades into <code>--color-bg</code></p>
      </section>
    </main>
  </div>
</Layout>

<style>
  .sg-hero {
    position: relative;
    padding-block: 2.5rem 5rem;
    background:
      linear-gradient(to bottom, rgba(20, 43, 34, 0) 40%, var(--color-bg) 100%),
      url('/images/bokeh-bg.webp') top center / 100% auto no-repeat,
      var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .sg-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .sg-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
    max-width: 48rem;
  }

  .lead {
    font-size: var(--text-lead);
    color: var(--color-text-muted);
    max-width: 34rem;
  }

  .body-copy {
    color: var(--color-text-muted);
    max-width: 44rem;
  }

  .small-copy {
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 40rem;
  }

  .sg-main {
    padding-block: 4rem 6rem;
  }

  .sg-section {
    padding-block: 3.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .sg-section:last-child {
    border-bottom: 0;
  }

  .sg-section__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .sg-section__head--sub {
    margin-top: 3rem;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
  }

  /* Swatches */
  .swatches {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
  }

  .swatch {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .swatch__chip {
    height: 88px;
    border-radius: var(--radius-input);
    border: 1px solid var(--color-border-strong);
    margin-bottom: 0.4rem;
  }

  .swatch__name {
    font-size: var(--text-small);
    font-weight: 500;
  }

  /* Families */
  .families {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .family__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .family__sample {
    font-size: 2rem;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .family__sample span,
  .family__sample em,
  .family__sample strong {
    font-size: 1rem;
    margin-left: 0.5rem;
    color: var(--color-text-muted);
  }

  .family__sample--title {
    font-family: var(--font-title);
    font-weight: 300;
  }

  .family__sample--title strong {
    font-weight: 600;
  }

  .family__sample--mono {
    font-family: var(--font-mono);
  }

  .family__chars {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    word-break: break-word;
  }

  .title-font {
    font-family: var(--font-title);
  }

  .mono-font {
    font-family: var(--font-mono);
  }

  /* Scale */
  .scale {
    display: flex;
    flex-direction: column;
  }

  .scale__row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    align-items: baseline;
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .scale__meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
  }

  .scale__meta strong {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text);
  }

  /* Rows */
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-bottom: 2rem;
  }

  .row:has(:global(.tag)) {
    gap: 0.75rem;
  }

  /* Buttons */
  .states {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .state > span,
  .state-caption {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
  }

  .state :global(.btn--primary.is-hover) {
    background: var(--color-accent-hover);
    box-shadow: var(--glow-accent);
  }

  .state :global(.btn--outline.is-hover) {
    background: var(--color-accent-soft);
  }

  .block-demo {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 640px;
    margin-top: 2.5rem;
  }

  /* Form */
  .form-demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 3rem;
    align-items: start;
  }

  .field-states {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .card-demo {
    padding: 2.5rem;
    border-radius: calc(var(--radius-card) + 8px);
    background:
      url('/images/bokeh-bg.webp') center top / cover no-repeat,
      var(--color-bg);
  }

  .claim-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
  }

  .span-2 {
    grid-column: span 2;
  }

  .submit {
    margin-top: 0.5rem;
  }

  .force-focus :global(.field__input) {
    border-color: var(--color-accent);
    background: rgba(20, 43, 34, 0.75);
    box-shadow: 0 0 0 3px rgba(126, 232, 168, 0.12);
  }

  /* Accordion */
  .acc-demo {
    max-width: 960px;
  }

  /* Foundations */
  .radius {
    display: grid;
    place-items: center;
    width: 120px;
    height: 80px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
  }

  .spacing {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .space {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .space__bar {
    display: block;
    height: 12px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .bg-preview {
    height: 320px;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    background:
      linear-gradient(to bottom, rgba(20, 43, 34, 0) 45%, var(--color-bg) 100%),
      url('/images/bokeh-bg.webp') top center / 100% auto no-repeat,
      var(--color-bg);
    margin-bottom: 0.75rem;
  }

  @media (max-width: 820px) {
    .scale__row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .form-demo {
      grid-template-columns: 1fr;
    }

    .card-demo {
      padding: 1rem;
    }

    .claim-grid {
      grid-template-columns: 1fr;
    }

    .span-2 {
      grid-column: auto;
    }

    .sg-hero__inner {
      gap: 3.5rem;
    }
  }
</style>
