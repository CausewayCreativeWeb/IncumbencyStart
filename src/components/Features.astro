---
const features = [
  {
    title: 'Resend for email',
    body: 'The contact form posts to a serverless API route that sends transactional email through Resend.',
  },
  {
    title: 'Mailchimp for growth',
    body: 'The newsletter form adds subscribers straight to a Mailchimp audience via the API — no embedded iframe.',
  },
  {
    title: 'Analytics on Vercel',
    body: 'Vercel Web Analytics is enabled through the Astro adapter, so pageviews are tracked automatically once deployed.',
  },
];
---

<section id="features">
  <div class="wrap grid">
    {features.map((feature) => (
      <div class="card">
        <h3>{feature.title}</h3>
        <p>{feature.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.75rem;
  }

  .card h3 {
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .card p {
    margin: 0;
    font-size: 0.95rem;
  }
</style>
