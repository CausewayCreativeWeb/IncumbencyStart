---
import SiteHeader from './SiteHeader.astro';
import ClaimForm from './ClaimForm.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import Tag from '../ui/Tag.astro';
import Card from '../ui/Card.astro';
---

<section class="hero">
  <SiteHeader />
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <Eyebrow variant="badge">Claim your bag</Eyebrow>
      <Heading level={1}>Let's make <strong>democratic data more secure.</strong></Heading>
      <p class="hero__lead">
        We are giving away anti-theft laptop bags to Parliamentary staffers to protect physical data security. Claim
        yours today.
      </p>
      <ul class="hero__tags" aria-label="Accreditations">
        <li><Tag>CREST Tested</Tag></li>
        <li><Tag>Cyber Essentials Plus</Tag></li>
        <li><Tag variant="gold">UK Data Residency</Tag></li>
      </ul>
    </div>

    <div class="hero__form" id="claim">
      <Card>
        <h2 class="visually-hidden">Claim your anti-theft laptop bag</h2>
        <ClaimForm />
      </Card>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-bottom: clamp(4rem, 3rem + 4vw, 8rem);
    border-bottom: 1px solid var(--color-border);
    background:
      linear-gradient(to bottom, rgba(20, 43, 34, 0) 0, rgba(20, 43, 34, 0.35) 12rem, var(--color-bg) 34rem),
      url('/images/bokeh-bg.webp') center -4vw / max(100%, 1100px) auto no-repeat,
      var(--color-bg);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 1rem + 4vw, 5rem);
    align-items: start;
    padding-top: clamp(1.5rem, 1rem + 2vw, 3.5rem);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
    padding-top: 1.25rem;
  }

  .hero__lead {
    font-size: var(--text-lead);
    color: var(--color-text-muted);
    max-width: 33rem;
    line-height: 1.65;
  }

  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
  }

  .hero__form {
    scroll-margin-top: 2rem;
  }

  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__copy {
      padding-top: 0;
    }
  }
</style>
