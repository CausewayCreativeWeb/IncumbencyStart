---
import Field from '../ui/Field.astro';
import Button from '../ui/Button.astro';
---

<form id="claim-form" class="claim-form" novalidate>
  <div class="span-2">
    <Field label="Full name" name="name" placeholder="Jane Okafor" autocomplete="name" required />
  </div>
  <Field label="Mobile" name="mobile" type="tel" placeholder="07700 000000" autocomplete="tel" inputmode="tel" required />
  <Field label="MP's office" name="office" placeholder="MP's Office" autocomplete="organization" required />
  <div class="span-2">
    <Field label="Email" name="email" type="email" placeholder="jane.okafor@parliament.uk" autocomplete="email" required />
  </div>
  <div class="span-2 claim-form__submit">
    <Button type="submit" icon="arrow-right" block>Get my bag</Button>
  </div>
  <p class="span-2 claim-form__note">
    By claiming, you agree to hear from Incumbency.AI about your bag and our platform. Unsubscribe any time.
  </p>
  <p id="claim-status" class="span-2 claim-form__status" role="status" aria-live="polite"></p>
</form>

<style>
  .claim-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
  }

  .span-2 {
    grid-column: span 2;
  }

  .claim-form__submit {
    margin-top: 0.5rem;
  }

  .claim-form__note {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-subtle);
    margin-top: -0.5rem;
  }

  .claim-form__status {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-accent);
    margin-top: -0.75rem;
  }

  .claim-form__status:empty {
    display: none;
  }

  .claim-form__status.is-error {
    color: var(--color-danger);
  }

  /* Success state: the submit button briefly confirms the claim. */
  @keyframes claimed-pop {
    40% {
      transform: scale(1.02);
    }
  }

  .claim-form :global(.btn.is-success) {
    opacity: 1;
    cursor: default;
    animation: claimed-pop 420ms var(--ease-out);
    box-shadow: var(--glow-accent);
  }

  .claim-form :global(.btn.is-success .btn__icon) {
    transform: none;
  }

  @media (max-width: 520px) {
    .claim-form {
      grid-template-columns: 1fr;
    }

    .span-2 {
      grid-column: auto;
    }
  }
</style>

<script>
  const form = document.getElementById('claim-form') as HTMLFormElement | null;
  const status = document.getElementById('claim-status');
  const emailInput = form?.querySelector<HTMLInputElement>('input[name="email"]');
  const emailError = document.getElementById(`${emailInput?.id}-error`);

  // Only Parliamentary addresses can claim a bag.
  const ALLOWED_DOMAIN = 'parliament.uk';
  const DOMAIN_ERROR = 'Please use your @parliament.uk email address. Other email addresses can\'t claim a bag.';

  function isParliamentEmail(value: string) {
    const email = value.trim().toLowerCase();
    const at = email.lastIndexOf('@');
    return at > 0 && email.slice(at + 1) === ALLOWED_DOMAIN;
  }

  function setEmailError(message: string | null) {
    if (!emailInput || !emailError) return;
    emailInput.closest('.field')?.classList.toggle('field--error', Boolean(message));
    emailError.textContent = message ?? '';
    emailError.hidden = !message;
    if (message) {
      emailInput.setAttribute('aria-invalid', 'true');
      emailInput.setAttribute('aria-describedby', emailError.id);
    } else {
      emailInput.removeAttribute('aria-invalid');
      emailInput.removeAttribute('aria-describedby');
    }
  }

  emailInput?.addEventListener('input', () => setEmailError(null));

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const button = form.querySelector('button[type="submit"]');
    const label = button?.querySelector('.btn__label');
    const icon = button?.querySelector('.btn__icon');
    const originalLabel = label?.textContent ?? '';
    const originalIcon = icon?.textContent ?? '';
    let succeeded = false;
    const formData = new FormData(form);
    const payload = {
      name: String(formData.get('name') ?? ''),
      mobile: String(formData.get('mobile') ?? ''),
      office: String(formData.get('office') ?? ''),
      email: String(formData.get('email') ?? ''),
    };

    status.classList.remove('is-error');
    status.textContent = '';
    setEmailError(null);

    const emailRejected = Boolean(emailInput?.validity.valid) && !isParliamentEmail(payload.email);
    if (emailRejected) setEmailError(DOMAIN_ERROR);

    if (!form.checkValidity()) {
      status.classList.add('is-error');
      status.textContent = 'Please fill in every field with a valid email address.';
      form.querySelector<HTMLInputElement>(':invalid')?.focus();
      return;
    }

    if (emailRejected) {
      emailInput?.focus();
      return;
    }

    button?.setAttribute('disabled', 'true');
    if (label) label.textContent = 'Sending…';

    try {
      const response = await fetch('/api/claim', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error ?? 'Something went wrong.');
      }

      succeeded = true;
      status.textContent = "Thanks — your bag is claimed. We'll be in touch shortly.";
      form.reset();
      button?.classList.add('is-success');
      if (label) label.textContent = 'Claimed';
      if (icon) icon.textContent = '✓';
      window.setTimeout(() => {
        button?.classList.remove('is-success');
        button?.removeAttribute('disabled');
        if (label) label.textContent = originalLabel;
        if (icon) icon.textContent = originalIcon;
      }, 4000);
    } catch (error) {
      status.classList.add('is-error');
      status.textContent = error instanceof Error ? error.message : 'Something went wrong.';
    } finally {
      if (!succeeded) {
        button?.removeAttribute('disabled');
        if (label) label.textContent = originalLabel;
      }
    }
  });
</script>
