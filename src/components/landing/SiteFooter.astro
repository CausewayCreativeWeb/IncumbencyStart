---
import Logo from '../ui/Logo.astro';
import { PRIVACY_POLICY_URL } from '../../lib/site';

interface Props {
  privacyHref?: string;
}

const { privacyHref = PRIVACY_POLICY_URL } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <Logo />
    <div class="site-footer__meta">
      <a href={privacyHref} target="_blank" rel="noopener">
        Privacy notice<span class="visually-hidden"> (opens in a new window)</span>
      </a>
      <button type="button" class="site-footer__link" data-cookie-settings>Cookie settings</button>
      <span>&copy; {year} Incumbency.AI</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: 2rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    font-size: var(--text-small);
    color: var(--color-text-subtle);
  }

  .site-footer__meta a,
  .site-footer__link {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__link {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .site-footer__meta a:hover,
  .site-footer__link:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  @media (max-width: 520px) {
    .site-footer__inner {
      flex-wrap: nowrap;
    }

    .site-footer__meta {
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
