<section id="newsletter">
  <div class="wrap panel">
    <h2>Get product updates</h2>
    <p>Subscribe to hear about new releases. No spam, unsubscribe any time.</p>
    <form id="newsletter-form" novalidate>
      <input type="email" name="email" placeholder="you@example.com" required aria-label="Email address" />
      <button type="submit">Subscribe</button>
    </form>
    <p id="newsletter-status" role="status" aria-live="polite"></p>
  </div>
</section>

<style>
  #newsletter {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .panel {
    text-align: center;
  }

  h2 {
    font-size: 1.75rem;
  }

  form {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  input {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    min-width: 260px;
  }

  input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  button {
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    border: none;
    background: var(--color-accent);
    color: white;
    font-weight: 600;
    cursor: pointer;
  }

  button:hover {
    background: var(--color-accent-hover);
  }

  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  #newsletter-status {
    min-height: 1.5rem;
    font-size: 0.9rem;
  }
</style>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const status = document.getElementById('newsletter-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const button = form.querySelector('button');
    const email = (form.elements.namedItem('email') as HTMLInputElement)?.value ?? '';

    button?.setAttribute('disabled', 'true');
    status.textContent = 'Subscribing…';

    try {
      const response = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error ?? 'Something went wrong.');
      }

      status.textContent = data.alreadySubscribed
        ? "You're already subscribed!"
        : 'Thanks for subscribing!';
      form.reset();
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Something went wrong.';
    } finally {
      button?.removeAttribute('disabled');
    }
  });
</script>
