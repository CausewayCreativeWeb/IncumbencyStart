---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  label: string;
  name: string;
  id?: string;
  error?: string;
} & HTMLAttributes<'input'>;

const { label, name, id = `field-${name}`, error, type = 'text', ...rest } = Astro.props;
const errorId = `${id}-error`;
---

<div class:list={['field', error && 'field--error']}>
  <label class="field__label" for={id}>{label}</label>
  <input
    class="field__input"
    id={id}
    name={name}
    type={type}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={error ? errorId : undefined}
    {...rest}
  />
  {error && <p class="field__error" id={errorId}>{error}</p>}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
  }

  .field__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .field__input {
    width: 100%;
    min-height: 3.75rem;
    padding: 0 1.1rem;
    border-radius: var(--radius-input);
    border: 1px solid var(--color-border);
    background: var(--color-input);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    transition:
      border-color var(--transition),
      background-color var(--transition),
      box-shadow var(--transition);
  }

  .field__input::placeholder {
    color: var(--color-text-subtle);
    opacity: 1;
  }

  .field__input:hover {
    border-color: var(--color-border-strong);
  }

  .field__input:focus {
    outline: none;
    border-color: var(--color-accent);
    background: rgba(20, 43, 34, 0.75);
    box-shadow: 0 0 0 3px rgba(126, 232, 168, 0.12);
  }

  .field--error .field__input {
    border-color: var(--color-danger);
  }

  .field__error {
    font-size: var(--text-small);
    color: var(--color-danger);
  }
</style>
