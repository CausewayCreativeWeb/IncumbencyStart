---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'outline';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  block?: boolean;
  icon?: 'arrow-right' | 'arrow-up';
  disabled?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'button'>, 'type'>;

const {
  variant = 'primary',
  href,
  type = 'button',
  block = false,
  icon,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn--${variant}`, block && 'btn--block', className];
const glyph = icon === 'arrow-right' ? '→' : icon === 'arrow-up' ? '↑' : null;
const leading = icon === 'arrow-up';
---

{
  href ? (
    <a class:list={classes} href={href} {...rest}>
      {leading && glyph && <span class="btn__icon" aria-hidden="true">{glyph}</span>}
      <span class="btn__label"><slot /></span>
      {!leading && glyph && <span class="btn__icon" aria-hidden="true">{glyph}</span>}
    </a>
  ) : (
    <button class:list={classes} type={type} disabled={disabled} {...rest}>
      {leading && glyph && <span class="btn__icon" aria-hidden="true">{glyph}</span>}
      <span class="btn__label"><slot /></span>
      {!leading && glyph && <span class="btn__icon" aria-hidden="true">{glyph}</span>}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-family: var(--font-body);
    font-size: var(--text-button);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    transition:
      background-color var(--transition),
      border-color var(--transition),
      color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .btn--primary {
    min-height: 4rem;
    padding: 0 2rem;
    border-radius: var(--radius-input);
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .btn--primary:hover:not(:disabled) {
    background: var(--color-accent-hover);
    box-shadow: var(--glow-accent);
  }

  .btn--primary:active:not(:disabled) {
    transform: translateY(1px);
  }

  .btn--outline {
    min-height: 3.75rem;
    padding: 0 2rem;
    border-radius: var(--radius-pill);
    border-color: var(--color-accent);
    background: transparent;
    color: var(--color-accent);
  }

  .btn--outline:hover {
    background: var(--color-accent-soft);
  }

  .btn--block {
    display: flex;
    width: 100%;
  }

  .btn:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .btn__icon {
    font-size: 1.1em;
    transition: transform var(--transition);
  }

  .btn--primary:hover:not(:disabled) .btn__icon {
    transform: translateX(3px);
  }

  .btn--outline:hover .btn__icon {
    transform: translateY(-2px);
  }
</style>
