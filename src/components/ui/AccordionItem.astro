---
interface Props {
  title: string;
  open?: boolean;
  name?: string;
  class?: string;
  style?: string;
}

const { title, open = false, name, class: className, style } = Astro.props;
---

<details class:list={['acc-item', className]} style={style} open={open} name={name}>
  <summary class="acc-item__summary">
    <h3 class="acc-item__title">{title}</h3>
    <span class="acc-item__icon" aria-hidden="true"></span>
  </summary>
  <div class="acc-item__body">
    <slot />
  </div>
</details>

<style>
  .acc-item {
    border-radius: var(--radius-panel);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition:
      border-color var(--transition),
      background-color var(--transition);
  }

  .acc-item:hover {
    border-color: var(--color-border-strong);
  }

  .acc-item[open] {
    background: var(--color-surface-raised);
  }

  .acc-item__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 1.75rem;
    cursor: pointer;
    list-style: none;
  }

  .acc-item__summary::-webkit-details-marker {
    display: none;
  }

  .acc-item__summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    border-radius: var(--radius-panel);
  }

  .acc-item__title {
    font-family: var(--font-title);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .acc-item__icon {
    position: relative;
    flex: none;
    width: 12px;
    height: 12px;
  }

  .acc-item__icon::before,
  .acc-item__icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 12px;
    height: 1.5px;
    margin-top: -0.75px;
    background: var(--color-accent);
    transition: transform var(--transition);
  }

  .acc-item__icon::after {
    transform: rotate(90deg);
  }

  .acc-item[open] .acc-item__icon::after {
    transform: rotate(0deg);
  }

  /* Smooth open/close where supported (::details-content + interpolate-size);
     other browsers keep the instant toggle. */
  .acc-item {
    interpolate-size: allow-keywords;
  }

  .acc-item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 320ms var(--ease-out),
      content-visibility 320ms allow-discrete;
  }

  .acc-item[open]::details-content {
    block-size: auto;
  }

  .acc-item:not([open]) .acc-item__body {
    opacity: 0;
  }

  .acc-item__body {
    transition: opacity 320ms var(--ease-out);
    padding: 0 1.75rem 1.75rem;
    max-width: 42rem;
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: 1.7;
  }
</style>
