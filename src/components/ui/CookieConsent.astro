---
import { PRIVACY_POLICY_URL } from '../../lib/site';
---

<div id="cookie-consent" class="cookie-consent" role="region" aria-label="Cookie consent" hidden>
  <p class="cookie-consent__text">
    We'd like to use analytics cookies to see how this site is used.
    <a href={PRIVACY_POLICY_URL} target="_blank" rel="noopener">
      Privacy policy<span class="visually-hidden"> (opens in a new window)</span>
    </a>
  </p>
  <div class="cookie-consent__actions">
    <button type="button" class="cookie-consent__btn" data-consent="denied">Decline</button>
    <button type="button" class="cookie-consent__btn cookie-consent__btn--accept" data-consent="granted">Accept</button>
  </div>
</div>

<style>
  .cookie-consent {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    max-width: 30rem;
    padding: 0.75rem 0.75rem 0.75rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-panel);
    background: var(--color-surface-raised);
    box-shadow: 0 12px 32px -12px rgba(4, 16, 11, 0.6);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    animation: rise 600ms var(--ease-out) 1.2s backwards;
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent__text a {
    color: var(--color-text);
    white-space: nowrap;
  }

  .cookie-consent__actions {
    display: flex;
    flex-shrink: 0;
    gap: 0.5rem;
  }

  .cookie-consent__btn {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    font: 600 0.8125rem/1 var(--font-body);
    cursor: pointer;
    transition:
      background-color var(--transition),
      border-color var(--transition);
  }

  .cookie-consent__btn:hover {
    border-color: var(--color-accent);
  }

  .cookie-consent__btn--accept {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .cookie-consent__btn--accept:hover {
    background: var(--color-accent-hover);
  }

  .cookie-consent__btn:focus-visible,
  .cookie-consent__text a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 520px) {
    .cookie-consent {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      max-width: none;
    }
  }
</style>

<script>
  import { ANALYTICS_ID, CONSENT_KEY } from '../../lib/site';

  const banner = document.getElementById('cookie-consent');

  function storedChoice() {
    try {
      return localStorage.getItem(CONSENT_KEY);
    } catch {
      return null;
    }
  }

  function clearAnalyticsCookies() {
    document.cookie.split(';').forEach((cookie) => {
      const name = cookie.split('=')[0].trim();
      if (!name.startsWith('_ga')) return;
      const domain = location.hostname.replace(/^www\./, '');
      ['', `; domain=${domain}`, `; domain=.${domain}`].forEach((scope) => {
        document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${scope}`;
      });
    });
  }

  function choose(choice: string) {
    try {
      localStorage.setItem(CONSENT_KEY, choice);
    } catch {
      // Storage blocked: the choice still applies for this page view.
    }
    if (choice === 'granted') {
      (window as any)[`ga-disable-${ANALYTICS_ID}`] = false;
      (window as any).loadAnalytics?.();
    } else {
      (window as any)[`ga-disable-${ANALYTICS_ID}`] = true;
      clearAnalyticsCookies();
    }
    if (banner) banner.hidden = true;
  }

  if (banner && !storedChoice()) banner.hidden = false;

  banner?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => {
    button.addEventListener('click', () => choose(button.dataset.consent ?? 'denied'));
  });

  document.querySelectorAll('[data-cookie-settings]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!banner) return;
      banner.hidden = false;
      banner.querySelector<HTMLButtonElement>('[data-consent="granted"]')?.focus();
    });
  });
</script>
