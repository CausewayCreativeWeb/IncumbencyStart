---
interface Props {
  variant?: 'badge' | 'plain' | 'muted';
  as?: 'p' | 'span' | 'div';
}

const { variant = 'plain', as: Tag = 'p' } = Astro.props;
---

<Tag class:list={['eyebrow', `eyebrow--${variant}`]}><slot /></Tag>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--color-accent);
    margin: 0;
  }

  .eyebrow--badge {
    display: inline-block;
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-tag);
    background: var(--color-accent-soft);
  }

  .eyebrow--muted {
    color: var(--color-accent);
    opacity: 0.85;
  }
</style>
