# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender address (must be on a domain verified in Resend)
RESEND_FROM_EMAIL=Website <hello@yourdomain.com>
# Inbox that receives contact-form submissions
CONTACT_TO_EMAIL=you@yourdomain.com

# Mailchimp — https://admin.mailchimp.com/account/api/
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# The data-center suffix from your API key, e.g. "us21"
MAILCHIMP_SERVER_PREFIX=us21
# Audience/List ID — https://admin.mailchimp.com/lists/
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx
